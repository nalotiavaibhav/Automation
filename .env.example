# Flowmax AI Receptionist — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Vapi (voice AI) ---
VAPI_PRIVATE_KEY=
DEFAULT_BUSINESS_ID=default
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- ServiceTitan ---
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_APP_KEY=
SERVICETITAN_TENANT_ID=
SERVICETITAN_ENV=integration

# --- HubSpot ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Zoho ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_WEBHOOK_TOKEN=

# Which CRM to sync to: 'hubspot' | 'zoho' | 'servicetitan' | 'housecallpro'
DEFAULT_CRM_PROVIDER=hubspot

# --- Twilio (urgent SMS alerts) ---
# A2P 10DLC registration is REQUIRED for US business SMS — see README "Pre-launch Checklist"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=          # E.164, e.g. +15551234567
OWNER_ALERT_PHONE=          # E.164, business owner's phone for emergency alerts
OWNER_TIMEZONE=America/New_York
